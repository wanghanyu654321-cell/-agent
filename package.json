{
	"name": "@wanghanyu654321-cell/customer-support-agent",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"build": "tsgo -p tsconfig.json",
		"check": "biome check --error-on-warnings . && tsgo --noEmit",
		"eval:safety": "node evals/safety/runner.ts",
		"eval:safety:holdout": "node evals/safety/holdout/runner.ts",
		"eval:safety:robustness": "node evals/safety/robustness/runner.ts",
		"eval:knowledge": "node evals/knowledge/runner.ts",
		"eval:retrieval:public": "node evals/retrieval/public-runner.ts",
		"eval:retrieval:public-real": "node evals/retrieval/run-public-benchmark.ts",
		"eval:selection:semantic": "node evals/selection/semantic/run-real.ts",
		"eval:selection:semantic:oauth-gate": "node evals/selection/semantic/run-oauth-aware-gate.ts",
		"eval:selection:semantic:holdout-v2.1": "node evals/selection/semantic/run-holdout-v2-1-gate.ts",
		"eval:selection:semantic:holdout-v2.2-boundary": "node evals/selection/semantic/run-holdout-v2-2-boundary-gate.ts",
		"eval:selection:semantic:final-v2.3.1": "node evals/selection/semantic/run-final-v2-3-1-true-unseen-gate.ts",
		"integrity": "node scripts/verify-integrity.mjs",
		"test": "vitest --run"
	},
	"dependencies": {
		"@earendil-works/pi-agent-core": "0.84.3",
		"@earendil-works/pi-ai": "0.84.3",
		"@earendil-works/pi-coding-agent": "0.84.3",
		"typebox": "1.3.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@types/node": "22.19.19",
		"@typescript/native-preview": "7.0.0-dev.20260120.1",
		"typescript": "5.9.3",
		"vitest": "4.1.9"
	}
}
