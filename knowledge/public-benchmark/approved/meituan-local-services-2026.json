[
  {"id":"PB-MT-VOUCHER-USE","kind":"policy","status":"approved","title":"美团团购券使用与有效期","content":"公开基准事实（美团团购用户服务条款，2026-04-23）：团购券应按团购合同和商品/服务说明使用；超过约定有效期后，不能再作为要求商户提供商品或服务的凭证。","version":"mt-terms-1.6-2026-04-23","updatedAt":"2026-04-23","sourceRef":"https://rules-center.meituan.com/m/detail/guize/1?activeRule=1#section-7","tags":["团购券","使用","有效期","过期","核销"]},
  {"id":"PB-MT-CHANGE-REFUND","kind":"policy","status":"approved","title":"商户变更团购内容时的退款条件","content":"公开基准事实（美团团购用户服务条款，2026-04-23）：因客观情况变化、页面信息错误、系统故障或物料短缺等导致商户需要变更团购合同内容，且用户不接受变更内容时，团购合同解除，用户可要求商户退款。","version":"mt-terms-1.6-2026-04-23","updatedAt":"2026-04-23","sourceRef":"https://rules-center.meituan.com/m/detail/guize/1?activeRule=1#section-9.1","tags":["变更","页面信息","团购内容","不接受","取消","退款","物料短缺"]},
  {"id":"PB-MT-MERCHANT-CANNOT-FULFILL","kind":"policy","status":"approved","title":"商户无法提供团购服务","content":"公开基准事实（美团团购用户服务条款，2026-04-23）：因不可抗力或商户原因导致商户无法提供团购商品或服务，经美团核实属实的，团购合同解除，用户可要求商户退款。","version":"mt-terms-1.6-2026-04-23","updatedAt":"2026-04-23","sourceRef":"https://rules-center.meituan.com/m/detail/guize/1?activeRule=1#section-9.1","tags":["商户原因","商家原因","无法提供","无法履约","做不了","停业","退款","核实"]},
  {"id":"PB-MT-AFTERSALES-CONTACT","kind":"policy","status":"approved","title":"消费后的特殊退款与售后联系","content":"公开基准事实（美团团购用户服务条款，2026-04-23）：用户实际消费后再要求商户退款，商户原则上可以拒绝；如消费过程中有其他特殊情况需要申请退款，应先联系商户，美团会视情况协助联系商户处理。","version":"mt-terms-1.6-2026-04-23","updatedAt":"2026-04-23","sourceRef":"https://rules-center.meituan.com/m/detail/guize/1?activeRule=1#section-9.2","tags":["已消费","用过服务","消费后","售后","特殊情况","联系商户","申请退款","客服"]},
  {"id":"PB-MT-REFUND-ORIGINAL-PAYMENT","kind":"policy","status":"approved","title":"符合条件退款的支付路径","content":"公开基准事实（美团团购用户服务条款，2026-04-23）：退款要求符合条件时，美团按退款服务条款和操作规则，将款项按用户的支付路径原路退回至支付账户；第三方支付规则或支付账户问题可能导致平台另行处理并告知用户。","version":"mt-terms-1.6-2026-04-23","updatedAt":"2026-04-23","sourceRef":"https://rules-center.meituan.com/m/detail/guize/1?activeRule=1#section-9.4","tags":["原路退回","原支付","支付账户","退款到账","第三方支付"]},
  {"id":"PB-MT-UNCONSUMED-REFUND","kind":"policy","status":"approved","title":"未消费团购券退款机制","content":"公开基准事实（美团团购服务保障，2026-01-01）：页面标明支持未消费退款或过期自动退的团购订单，按页面展示的退款机制处理；未消费随时退款审核通过后，退款通常在1至7个工作日退回原支付方。","version":"mt-guarantee-2026-01-01","updatedAt":"2026-01-01","sourceRef":"https://rules-center.meituan.com/m/detail/guize/386003?activeRule=1#unconsumed-refund","tags":["未消费","未核销","没有核销","没使用","随时退款","申请退款","退款时间","1至7个工作日"]},
  {"id":"PB-MT-EXPIRED-AUTO-REFUND","kind":"policy","status":"approved","title":"过期未消费团购券自动退款","content":"公开基准事实（美团团购服务保障，2026-01-01）：页面标明支持过期自动退的团购订单，在美团券有效期届满后，对未消费订单在7个工作日内自动退款；是否适用以页面标明支持过期自动退为准。","version":"mt-guarantee-2026-01-01","updatedAt":"2026-01-01","sourceRef":"https://rules-center.meituan.com/m/detail/guize/386003?activeRule=1#expired-auto-refund","tags":["过期自动退","过期","未消费","7个工作日","自动退款"]},
  {"id":"PB-MT-FULFILLMENT-RESERVATION","kind":"policy","status":"approved","title":"预约结果与商户接待","content":"公开基准事实（到店餐饮商户履约保障管理办法，2026-08-20）：用户按预约要求预定到店消费后，商户以不承认预约结果、预约满了或无法按预约要求提供服务等理由拒绝接待，属于规则列举的不接待场景。","version":"mt-fulfillment-2026-08-20","updatedAt":"2026-08-20","sourceRef":"https://rules-center.meituan.com/m/detail/guize/1174?activeRule=1#reservation","tags":["预约","预定成功","预约满了","预约结果","不接待","拒绝接待","到店消费"]},
  {"id":"PB-MT-FULFILLMENT-CLOSURE","kind":"policy","status":"approved","title":"商户装修歇业时的团购可用性告知","content":"公开基准事实（到店餐饮商户履约保障管理办法，2026-08-20）：商户因装修、歇业等客观原因无法正常营业，应提前在官方路径告知并设置团购不可用时间；未提前告知和设置而导致用户到店无法消费，属于规则列举的不接待场景。","version":"mt-fulfillment-2026-08-20","updatedAt":"2026-08-20","sourceRef":"https://rules-center.meituan.com/m/detail/guize/1174?activeRule=1#closure","tags":["商家","到店","装修","歇业","关门","无法营业","不可用时间","到店无法消费"]},
  {"id":"PB-MT-FULFILLMENT-ALTERNATIVE","kind":"policy","status":"approved","title":"商户无法提供团购组成时的接待规则","content":"公开基准事实（到店餐饮商户履约保障管理办法，2026-08-20）：商户因经营调整无法提供团购中的部分商品或服务时，应提前修改组成，替换价值不得低于原价值；若用户不认可替换方案，商户应线下沟通并正常接待。","version":"mt-fulfillment-2026-08-20","updatedAt":"2026-08-20","sourceRef":"https://rules-center.meituan.com/m/detail/guize/1174?activeRule=1#alternative","tags":["替换方案","原项目没有","经营调整","团购组成","价值不得低于","不认可"]},
  {"id":"PB-DP-HELP-UNVERIFIED","kind":"faq","status":"approved","title":"大众点评普通团购券未验证退款帮助","content":"公开基准事实（大众点评官方帮助页，检索于2026-08-29）：普通团购券未消费时可在订单中申请退款；已验证的美团券不适用该帮助页所述的未消费退款说明。","version":"dp-help-retrieved-2026-08-29","updatedAt":"2026-08-29","sourceRef":"https://kf.dianping.com/csCenter/app/questions/16403","tags":["普通团购券","未验证","已验证","我的订单","退款帮助"]},
  {"id":"PB-MT-SCOPE-TENANT","kind":"reference","status":"approved","title":"公开基准租户隔离探针","content":"公开基准治理探针：本条复用公开团购券有效期事实，仅用于验证受治理知识在指定租户外不得返回。","version":"mt-scope-probe-2026-08-29","updatedAt":"2026-08-29","sourceRef":"https://rules-center.meituan.com/m/detail/guize/1?activeRule=1#section-7","tags":["租户专属基准令牌A"],"tenantScope":"public-benchmark-tenant-a","storeScope":"public-benchmark-store-a"},
  {"id":"PB-MT-SCOPE-STORE","kind":"reference","status":"approved","title":"公开基准门店隔离探针","content":"公开基准治理探针：本条复用公开未消费退款事实，仅用于验证受治理知识在指定门店外不得返回；它不代表任何门店政策。","version":"mt-store-probe-2026-08-29","updatedAt":"2026-08-29","sourceRef":"https://rules-center.meituan.com/m/detail/guize/386003?activeRule=1#unconsumed-refund","tags":["门店专属基准令牌B"],"tenantScope":"public-benchmark-tenant-a","storeScope":"public-benchmark-store-a"}
]
